number;\n\n    constructor(private analogPin: AnalogPin) {\n        this.openingLevel = (pins.analogReadPin(analogPin));\n    }\n\n    getOpeningLevel() { return this.openingLevel }\n\n    open(level: number) {\n        pins.analogWritePin(this.analogPin, (level <= 100) ? level : 100);\n        this.openingLevel = level;\n    }\n\n    fullClose() {\n        pins.analogWritePin(this.analogPin, 0);\n        this.openingLevel = 0;\n    }\n}\n\nclass QE {\n    private concentrationLevel: number;\n\n    constructor(private analogPin: AnalogPin) {\n        this.concentrationLevel = (pins.analogReadPin(analogPin));\n    }\n\n    getConcentrationLevel() { return this.concentrationLevel }\n\n    setConcentrationLevel(level: number) {\n        pins.analogWritePin(this.analogPin, (level <= 100) ? level : 100);\n        this.concentrationLevel = level;\n    }\n\n    reset() {\n        pins.analogWritePin(this.analogPin, 0);\n        this.concentrationLevel = 0;\n    }\n}\n\nclass KM {\n    private state: boolean;\n\n    constructor(private digitalPin: DigitalPin) {\n        this.state = false;\n    }\n\n    isStarted() {\n        return this.state;\n    }\n\n    start() {\n        this.state = true;\n        pins.digitalWritePin(this.digitalPin, 1);\n    }\n\n    stop() {\n        this.state = false;\n        pins.digitalWritePin(this.digitalPin, 0);\n    }\n\n}\n\n// let levelA = new LE(ioInfo.LEa);\n// let levelB = new LE(ioInfo.LEb);\n// let concentrationQE = new QE(ioInfo.QE);\n// let valveXV1 = new XV(ioInfo.XV1);\n// let valveCV2 = new CV(ioInfo.CV2);\n// let valveCV3 = new CV(ioInfo.CV3);\n// let valveXV4 = new XV(ioInfo.XV4);\n// let motorKM1 = new KM(ioInfo.KM1);\n\nenum states { init, idle, load1, mix, load2, waitingConcentration, dwnld };\n\nlet state = states.init;\nlet isStarted = false;\nlet timeout = ((3 * 60) + 15) * 1000\nserial.writeLine('Program started');\n\n\n\nbasic.forever(function () {\n    let SB1 = (pins.digitalReadPin(ioInfo.SB1) === 1) || input.buttonIsPressed(Button.A);\n    let SB2 = (pins.digitalReadPin(ioInfo.SB2) === 1) || input.buttonIsPressed(Button.B);\n    let LEa = pins.digitalReadPin(ioInfo.LEa);\n    let LEb = pins.digitalReadPin(ioInfo.LEb);\n    let QE = pins.analogReadPin(ioInfo.QE);\n    let XV1 = pins.digitalReadPin(ioInfo.XV1);\n    let CV2 = pins.analogReadPin(ioInfo.CV2);\n    let CV3 = pins.analogReadPin(ioInfo.CV3);\n    let XV4 = pins.digitalReadPin(ioInfo.XV4);\n    let KM1 = pins.digitalReadPin(ioInfo.KM1);\n\n    if (SB1) { state = states.idle; isStarted = true }\n\n    switch (state) {\n        case states.init:\n            pins.digitalWritePin(ioInfo.LEa, 0);\n            pins.digitalWritePin(ioInfo.LEb, 0);\n            pins.analogWritePin(ioInfo.QE, 0);\n            pins.digitalWritePin(ioInfo.XV1, 0);\n            pins.analogWritePin(ioInfo.CV2, 0);\n            pins.analogWritePin(ioInfo.CV3, 0);\n            pins.digitalWritePin(ioInfo.XV4, 0);\n            pins.digitalWritePin(ioInfo.KM1, 0);\n            break;\n\n        case states.idle:\n            pins.digitalWritePin(ioInfo.XV4, 0);\n            pins.digitalWritePin(ioInfo.KM1, 0);\n            if (isStarted) {\n                if (QE === 100) {\n                    state = states.dwnld;\n                    serial.writeLine('Downloading');\n                } else {\n                    state = states.load1;\n                    serial.writeLine('Loading 1');\n                }\n            }\n            break;\n\n        case states.load1:\n            pins.digitalWritePin(ioInfo.XV1, 1);\n            serial.writeLine('Loading1');\n            if (LEa === 1) {\n                pins.digitalWritePin(ioInfo.XV1, 0);\n                state = states.mix;\n            }\n            break;\n\n        case states.mix:\n            pins.digitalWritePin(ioInfo.KM1, 1);\n            serial.writeLine('Mixing')\n            state = states.load2;\n            break;\n\n        case states.load2:\n            pins.analogWritePin(ioInfo.CV2, 40);\n            // pins.analogWritePin(ioInfo.tv1, 1023);\n            if (te1 > 516) {\n                state = states.hea2;\n                serial.writeLine('Heating2')\n            }\n            break;\n        case states.waitingConcentration:\n            pins.analogWritePin(ioInfo.tv1, 516);\n            if (te1 > 567) {\n                state = states.dwnld;\n                serial.writeLine('Downloading')\n            }\n            break\n        case states.dwnld:\n            pins.analogWritePin(ioInfo.tv1, 0);\n            pins.digitalWritePin(ioInfo.lvs3, 1);\n            if (LEa === 0) {\n                if (SB2) {\n                    state = states.idle;\n                    serial.writeLine('Program stopped')\n                } else {\n                    state = states.load1;\n                    serial.writeLine('Next cycle')\n                }\n            }\n            break\n        default:\n            state = states.idle;\n    }\n\n    basic.pause(200);\n})\n\n\n\n\n\n\n\n\n\n\n\n// basic.forever(function () {\n\t\n//     basic.showString(\"Hello!\")\n// })\n\n// let count = 0;\n// basic.forever(function () {\n//     count += 1;\n//     // console.log(count);\n//     serial.writeLine(count.toString());\n//     basic.pause(500);\n// })\n\n// let count = 0;\n// let arr = [];\n// basic.forever(function () {\n//     count += 1;\n//     arr = [count, count + 10.5, count + 21];\n//     serial.writeNumbers(arr); // виведення масиву\n//     basic.pause(500) //ставимо паузу до наступного виклику 500 мс \n// })\n\n// let count = 0;\n// let arr = [];\n// basic.forever(function () {\n//     count += 1;\n//     arr = [count, count + 10.5, count + 21];\n//     serial.writeValue(\"count\", count);\n//     serial.writeValue(\"arr[0]\", arr[0]);\n//     basic.pause(500) //ставимо паузу до наступного виклику 500 мс \n// })\n\n// let count = 0;\n// basic.forever(function () {\n//     count += 1;\n//     serial.writeValue(\"count.base\", count);\