 this._isOpen = true;\n    }\n\n    close() {\n        pins.digitalWritePin(this.digitalPin, 0);\n        this._isOpen = false;\n    }\n}\n\nclass CV {\n    private openingLevel: number;\n\n    constructor(private analogPin: AnalogPin) {\n        this.openingLevel = (pins.digitalReadPin(analogPin));\n    }\n\n    getOpeningLevel() { return this.openingLevel }\n\n    open(level: number) {\n        pins.digitalWritePin(this.analogPin, (level <= 100) ? level : 100);\n        this.openingLevel = level;\n    }\n\n    fullClose() {\n        pins.analogWritePin(this.analogPin, 0);\n        this.openingLevel = 0;\n    }\n}\n\nclass KM {\n    private state: boolean;\n\n    constructor(private digitalPin: DigitalPin) {\n        this.state = false;\n    }\n\n    start() {\n        this.state = true;\n        pins.digitalWritePin(this.digitalPin, 1);\n    }\n    \n\n}\n\nenum states { init, idle, load1, load2, hea1, hea2, dwnld };\n\nlet state = states.idle;\nserial.writeLine('Program started');\n\nbasic.forever(function () {\n    let startPressed = (pins.digitalReadPin(ioInfo.SB1) === 1) || input.buttonIsPressed(Button.A);\n    let stopPressed = (pins.digitalReadPin(ioInfo.SB1) === 1) || input.buttonIsPressed(Button.B);\n    \n    let levelA = pins.digitalReadPin(ioInfo.LEa);\n    let levelB = pins.digitalReadPin(ioInfo.LEb);\n    let concentrationQE = pins.analogReadPin(ioInfo.QE);\n    let valveXV1 = pins.digitalReadPin(ioInfo.XV1);\n    let valveCV2 = pins.analogReadPin(ioInfo.CV2);\n    let valveCV3 = pins.analogReadPin(ioInfo.CV3);\n    let valveXV4 = pins.digitalReadPin(ioInfo.XV4);\n    let motorKM1 = pins.digitalReadPin(ioInfo.KM1);\n\n    switch (state) {\n        case states.idle:\n            pins.digitalWritePin(ioInfo.lvs1, 0);\n            pins.digitalWritePin(ioInfo.lvs2, 0);\n            pins.digitalWritePin(ioInfo.lvs3, 0);\n            pins.analogWritePin(ioInfo.tv1, 0);\n            if (startPressed) {\n                if (levelA === 1) {\n                  